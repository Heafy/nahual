{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) uv run black \"$f\" && uv run isort \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting with black + isort"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/presentation/tools/check_style.py\" --hook",
            "statusMessage": "Checking presentation style"
          }
        ]
      }
    ]
  }
}